<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The whole UI is Jetpack Compose; this theme only styles the window before
      the first frame, so it deliberately has no AppCompat/Material XML parent.
      v1 is light-only: there is no values-night override.
    -->
    <style name="Theme.HeyMika" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
